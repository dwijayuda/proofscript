{
  "schema": "proofscript.stdlib-profile/v1",
  "profileId": "proofscript-stdlib-v1",
  "status": "specified-bounded",
  "package": {
    "name": "@proofscript/std",
    "role": "implicit checked bootstrap",
    "sourceImportRequired": false
  },
  "resultLikeType": {
    "name": "Except",
    "shape": "Except(E, A)",
    "policy": "Product-v1 uses Except as the Result-like type; no duplicate Result alias is required."
  },
  "families": {
    "Eq": {
      "status": "supported-bounded",
      "required": [
        "Eq"
      ],
      "generated": [
        "Eq.refl",
        "Eq.rec"
      ]
    },
    "Nat": {
      "status": "supported-bounded",
      "required": [
        "Nat",
        "Nat.add",
        "Nat.pred",
        "Nat.sub",
        "Nat.mul",
        "Nat.leb",
        "Nat.beq",
        "Nat.ltb"
      ],
      "generated": [
        "Nat.zero",
        "Nat.succ",
        "Nat.rec"
      ]
    },
    "Bool": {
      "status": "supported-bounded",
      "required": [
        "Bool",
        "Bool.not",
        "Bool.xor"
      ],
      "generated": [
        "Bool.false",
        "Bool.true",
        "Bool.rec"
      ]
    },
    "Int": {
      "status": "supported-bounded",
      "required": [
        "Int",
        "Int.neg",
        "Int.add",
        "Int.sub",
        "Int.beq"
      ]
    },
    "String": {
      "status": "supported-bounded",
      "required": [
        "String"
      ],
      "limitations": [
        "type/literals are live; a broad String utility API is not yet Product-v1"
      ]
    },
    "Option": {
      "status": "supported-bounded",
      "required": [
        "Option",
        "Option.isSome",
        "Option.isNone",
        "Option.getD",
        "Option.orElse",
        "Option.fold",
        "Option.any",
        "Option.toList",
        "Option.toArray",
        "Option.filter",
        "Option.flatten",
        "Option.map",
        "Option.bind",
        "Option.toExcept"
      ],
      "generated": [
        "Option.none",
        "Option.some",
        "Option.rec"
      ]
    },
    "Except": {
      "status": "supported-bounded",
      "required": [
        "Except",
        "Except.isOk",
        "Except.isError",
        "Except.getD",
        "Except.orElse",
        "Except.toOption",
        "Except.toError",
        "Except.getErrorD",
        "Except.swap",
        "Except.fold",
        "Except.bimap",
        "Except.toList",
        "Except.toArray",
        "Except.mapError",
        "Except.flatten",
        "Except.map",
        "Except.bind"
      ],
      "generated": [
        "Except.error",
        "Except.ok",
        "Except.rec"
      ]
    },
    "List": {
      "status": "supported-bounded",
      "required": [
        "List",
        "List.map",
        "List.foldl",
        "List.filter",
        "List.append",
        "List.length",
        "List.range",
        "List.replicate",
        "List.singleton",
        "List.toArray",
        "List.isEmpty",
        "List.head?",
        "List.get?",
        "List.last?",
        "List.tail?",
        "List.take",
        "List.takeWhile",
        "List.dropWhile",
        "List.drop",
        "List.reverse",
        "List.any",
        "List.all",
        "List.find?",
        "List.countP"
      ],
      "generated": [
        "List.nil",
        "List.cons",
        "List.rec"
      ]
    },
    "Array": {
      "status": "supported-bounded",
      "required": [
        "Array",
        "Array.size",
        "Array.range",
        "Array.replicate",
        "Array.singleton",
        "Array.toList",
        "Array.get?",
        "Array.head?",
        "Array.last?",
        "Array.tail?",
        "Array.map",
        "Array.foldl",
        "Array.filter",
        "Array.append",
        "Array.isEmpty",
        "Array.take",
        "Array.takeWhile",
        "Array.dropWhile",
        "Array.drop",
        "Array.reverse",
        "Array.any",
        "Array.all",
        "Array.find?",
        "Array.countP"
      ],
      "generated": [
        "Array.mk",
        "Array.rec"
      ]
    }
  },
  "packageLayer": {
    "jsonValidation": {
      "status": "implemented-trusted-host-bounded",
      "profile": "config/proofscript-json-validation-v1.json",
      "package": "@proofscript/json-validation",
      "example": "examples/product-v1/json-validation-app",
      "trust": "trusted-external",
      "boundary": "String/Bool text validation only",
      "parserVerified": false,
      "structuredJsonValueModel": false,
      "gate": "test:product-v1:json-validation"
    },
    "http": {
      "status": "missing"
    },
    "database": {
      "status": "missing"
    },
    "packageSourceResolution": {
      "status": "project-modules-only",
      "note": "ProofScript source imports resolve deterministic project modules; npm package names are currently execution/host interop, not ProofScript source modules."
    },
    "dependencyCertificateIdentity": {
      "status": "implemented-for-implicit-stdlib-and-npm-ffi",
      "stdlib": "implicit @proofscript/std manifest/hash identity is certificate-bound",
      "npmFfi": "bare npm FFI dependencies are resolved relative to the FFI manifest and bound by package name/version/package.json SHA-256/content-tree SHA-256",
      "identitySchema": "proofscript.npm-dependency-identity/v1",
      "tamperRejection": true,
      "sourcePackageImports": "source package module bytes are Core-module-source-hash bound; installed source-package revalidation in public certificate verify remains future hardening"
    },
    "sourcePackages": {
      "status": "implemented-pending-execution",
      "declaration": "package.json.proofscript.sourceRoot",
      "importModel": "ordinary ProofScript module names; A.B resolves to A/B.ps across deterministic local/package source roots",
      "discovery": "declared dependencies/optionalDependencies/devDependencies installed under project node_modules",
      "failClosed": [
        "absolute or escaping proofscript.sourceRoot",
        "missing source root",
        "duplicate source root",
        "missing module",
        "ambiguous module across local/package roots",
        "module import cycles"
      ],
      "provenance": [
        "package name/version/package.json SHA-256 in ProjectModuleGraph.packages",
        "per-module exact source SHA-256 in checked Core module metadata"
      ],
      "publishingFixture": "examples/product-v1/source-package-math",
      "consumerFixture": "examples/product-v1/source-package-app",
      "gate": "test:product-v1:source-package"
    }
  },
  "trustBoundary": [
    "checked bootstrap declarations are replayed by PSKernel when loaded",
    "some bounded collection/Int computations are runtime/kernel primitives with explicit assumption status",
    "bootstrap presence does not imply full Lean standard-library equivalence",
    "runtime representation remains governed separately by proofscript-js-runtime-v1"
  ]
}
