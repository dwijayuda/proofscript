  "workflowStages": [
    {
      "id": "propose-feature",
      "title": "Propose Feature",
      "purpose": "State the user-visible feature, scope, non-goals, and intended lifecycle before touching production code.",
      "requiredEvidence": [
        "feature spec or implementation plan",
        "planned package list",
        "proof obligation IDs"
      ],
      "blocksPromotion": true
    },
    {
      "id": "scope-feature",
      "title": "Scope Feature Boundary",
      "purpose": "Decide whether the feature is parser-only, checked bootstrap, existing kernel rule, trusted-kernel change, or execution-only-after-core.",
      "requiredEvidence": [
        "trustLevel",
        "kernelImpact",
        "production package list"
      ],
      "blocksPromotion": true
    },
    {
      "id": "red-tests",
      "title": "Write Failing Tests First",
      "purpose": "Add parser/elaborator/runtime/proof negative tests before implementation and confirm the expected failure mode.",
      "requiredEvidence": [
        "failing targeted regression",
        "negative rejection case"
      ],
      "blocksPromotion": true
    },
    {
      "id": "implement-parser-elaborator-kernel",
      "title": "Implement Checked Frontend Path",
      "purpose": "Route syntax through parser and elaborator into checked Core or checked bootstrap declarations instead of backend shortcuts.",
      "requiredEvidence": [
        "parser evidence",
        "elaborator/kernel evidence",
        "checked bootstrap or proof obligation story"
      ],
      "blocksPromotion": true
    },
    {
      "id": "implement-backend-runtime",
      "title": "Implement Execution After Core",
      "purpose": "Add backend/runtime behavior only after checked Core exists and only for executable features.",
      "requiredEvidence": [
        "JS execution smoke",
        "TypeScript compile smoke",
        "runtime/backend evidence"
      ],
      "blocksPromotion": true
    },
    {
      "id": "link-proof-obligations",
      "title": "Link Proof Obligations",
      "purpose": "Connect the feature to known proof obligations so formal debt is explicit and machine-checked.",
      "requiredEvidence": [
        "proofObligationIds",
        "non-claim statement"
      ],
      "blocksPromotion": true
    },
    {
      "id": "update-governance-traceability",
      "title": "Update Governance and Traceability",
      "purpose": "Update feature promotion, verification matrix, production traceability, and documentation before release.",
      "requiredEvidence": [
        "feature-promotion entry",
        "verification claim if needed",
        "release report"
      ],
      "blocksPromotion": true
    },
    {
      "id": "verify-and-report",
      "title": "Verify and Report",
      "purpose": "Run the focused matrix and fresh-extract smoke before claiming support.",
      "requiredEvidence": [
        "build",
        "architecture",
        "language-fast or focused smoke",
        "kernel status",
        "archive integrity"
      ],
      "blocksPromotion": true
    }
  ],
