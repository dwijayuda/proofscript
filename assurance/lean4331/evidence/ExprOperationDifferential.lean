def main : IO Unit := do
  let mut sbad := 0
  for (e,c,d,expected) in shiftCases do
    let actual := e.liftLooseBVars c d
    if actual != expected then sbad := sbad + 1
  let mut ibad := 0
  for (b,a,expected) in instCases do
    let actual := b.instantiate1 a
    if actual != expected then ibad := ibad + 1
  IO.println s!"SHIFT_CASES={shiftCases.size} SHIFT_FAILURES={sbad}"
  IO.println s!"INSTANTIATE_CASES={instCases.size} INSTANTIATE_FAILURES={ibad}"
  if sbad != 0 || ibad != 0 then throw <| IO.userError "Expr operation differential mismatch"
