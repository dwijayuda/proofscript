{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "host",
    "outDir": "dist-host",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "host/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-host"
  ]
}
