-- Structures, field projection/update, user inductives, constructors, and match.

structure Pair where {
  fst : Nat;
  snd : Nat;
}

const pair : Pair := { fst := 20, snd := 22 };

function setFst(p : Pair, x : Nat) : Pair :=
  { p with fst := x };

const moved : Pair := setFst(pair, 40);
const pairSum : Nat := pair.fst + pair.snd;
const movedSum : Nat := moved.fst + moved.snd;

inductive Color: Type where {
  | red
  | green
  | blue
}

inductive MaybeNat: Type where {
  | none
  | some (value: Nat)
}

def redColor: Color := { Color.red }
def blueColor: Color := { Color.blue }

function colorCode(c: Color): Nat := {
  match (c) {
    | Color.red => 1
    | Color.green => 2
    | Color.blue => 3
  }
}

def maybeNone: MaybeNat := { MaybeNat.none }
def maybeSome: MaybeNat := { MaybeNat.some(7) }

function maybeDefault(m: MaybeNat): Nat := {
  match (m) {
    | MaybeNat.none => 0
    | MaybeNat.some value => value
  }
}

def redCode: Nat := { colorCode(redColor) }
def blueCode: Nat := { colorCode(blueColor) }
def noneDefault: Nat := { maybeDefault(maybeNone) }
def someDefault: Nat := { maybeDefault(maybeSome) }

theorem pair_sum_rfl : pairSum = 42 := by rfl
theorem moved_sum_rfl : movedSum = 62 := by rfl
theorem red_code_rfl : redCode = 1 := by rfl
theorem blue_code_rfl : blueCode = 3 := by rfl
theorem none_default_rfl : noneDefault = 0 := by rfl
theorem some_default_rfl : someDefault = 7 := by rfl
